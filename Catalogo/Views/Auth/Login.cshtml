@model MotoTrack.Domain.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="login-page">

    <div class="login-container">

        <div class="login-hero">
            <h1 class="login-title">MOTOTRACK</h1>
            <p class="login-subtitle">
                Controla tus motocicletas, mantenimientos y estadísticas desde un solo lugar.
            </p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="error-box">@ViewBag.Error</div>
        }

        <div class="login-form-box">

            <form asp-action="Login" method="post">

                <div class="form-group">
                    <label>Correo</label>
                    <input asp-for="Correo" class="login-input" />
                    <span asp-validation-for="Correo" class="error"></span>
                </div>

                <div class="form-group">
                    <label>Contraseña</label>
                    <input asp-for="Password" type="password" class="login-input" />
                    <span asp-validation-for="Password" class="error"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-mototrack-primary">Iniciar sesión</button>
                </div>

            </form>

            <p class="login-register-link">
                <a asp-controller="Auth" asp-action="Registro">Crear cuenta nueva</a>
            </p>

        </div>

    </div>

    <div class="login-showcase">
        <div class="login-showcase-image">
            <img src="~/mototrack-isotype.svg" width="64" height="64" alt="MotoTrack" class="navbar-logo" />
        </div>
        <div class="login-showcase-text">MotoTrack</div>
        <div class="login-showcase-sub">Próximamente</div>
    </div>

</div>
