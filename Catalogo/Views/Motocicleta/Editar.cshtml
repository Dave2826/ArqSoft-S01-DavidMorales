@model MotoTrack.Domain.Models.Motocicleta

@{
    ViewData["Title"] = "Editar Motocicleta";
}

<h2>Editar Motocicleta</h2>

<div class="card">
    <div class="card-body">

        <form asp-action="Editar" method="post" enctype="multipart/form-data">
            <input asp-for="Id" type="hidden" />
            <input asp-for="UsuarioId" type="hidden" />
            <input asp-for="FechaRegistro" type="hidden" />
            <input asp-for="Activa" type="hidden" />
            <input asp-for="FotoUrl" type="hidden" />

            <div class="form-group">
                <label>Marca</label>
                <input asp-for="Marca" />
                <span asp-validation-for="Marca" class="error"></span>
            </div>

            <div class="form-group">
                <label>Modelo</label>
                <input asp-for="Modelo" />
                <span asp-validation-for="Modelo" class="error"></span>
            </div>

            <div class="form-group">
                <label>Año</label>
                <input asp-for="Ano" />
                <span asp-validation-for="Ano" class="error"></span>
            </div>

            <div class="form-group">
                <label>Cilindrada</label>
                <input asp-for="Cilindrada" />
                <span asp-validation-for="Cilindrada" class="error"></span>
            </div>

            <div class="form-group">
                <label>Kilometraje Actual</label>
                <input asp-for="KilometrajeActual" />
                <span asp-validation-for="KilometrajeActual" class="error"></span>
            </div>

            <div class="form-group">
                <label>Kilometraje al comprar (solo si es usada)</label>
                <input asp-for="KilometrajeCompra" type="number" />
            </div>

            <hr />

            <h4>Fotografía</h4>

            @if (!string.IsNullOrEmpty(Model.FotoUrl))
            {
                <div style="margin-bottom:12px;">
                    <img src="@Model.FotoUrl" alt="@Model.Marca @Model.Modelo" style="max-width:200px;max-height:150px;border-radius:8px;border:1px solid #333;" />
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" name="eliminarFoto" value="true" />
                        Eliminar fotografía actual
                    </label>
                </div>
            }

            <div class="form-group">
                <label>Cambiar fotografía</label>
                <input type="file" name="foto" accept=".jpg,.jpeg,.png,.webp" />
            </div>

            <hr />

            <h4>Información opcional</h4>

            <div class="form-group">
                <label>Placas</label>
                <input asp-for="Placas" />
            </div>

            <div class="form-group">
                <label>VIN</label>
                <input asp-for="VIN" />
            </div>

            <div class="form-group">
                <label>Número de Motor</label>
                <input asp-for="NumeroMotor" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn">Guardar Motocicleta</button>
                <a asp-controller="Motocicleta" asp-action="Index" class="btn-cancel">Cancelar</a>
            </div>

        </form>

    </div>
</div>
