@functions {
    string NavActive(string controller, string action = "Index")
    {
        var c = ViewContext.RouteData.Values["controller"]?.ToString();
        var a = ViewContext.RouteData.Values["action"]?.ToString();
        return (c == controller && a == action) ? "nav-link-active" : "";
    }

    string NavActiveHref(string path)
    {
        var current = Context.Request.Path.Value ?? "";
        return current.StartsWith(path, StringComparison.OrdinalIgnoreCase) ? "nav-link-active" : "";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MotoTrack</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Montserrat:wght@700;800;900&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom sticky-top">
            <div class="container-fluid">

                <span class="navbar-brand">
                    <svg width="28" height="28" viewBox="0 0 32 32" class="navbar-logo">
                        <path d="M6 26 L10 6 L16 16 L22 6 L26 26" stroke="#ff7a00" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    MotoTrack
                </span>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (Context.Session.GetString("UsuarioId") == null)
                        {
                            <!-- Sin sesión -->
                            <li class="nav-item">
                                <a class="nav-link text-light @NavActive("Home", "Index")" asp-controller="Home" asp-action="Index">
                                    INICIO
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-warning @NavActive("MotoTrack", "Index")" asp-controller="MotoTrack" asp-action="Index">
                                    EXPLORAR
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light @NavActiveHref("/Auth/Login")" href="/Auth/Login">
                                    LOGIN
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light @NavActiveHref("/Auth/Registro")" href="/Auth/Registro">
                                    REGISTRO
                                </a>
                            </li>
                        }
                        else
                        {
                            <!-- Con sesión -->
                            <li class="nav-item">
                                <a class="nav-link text-light @NavActive("Home", "Index")" asp-controller="Home" asp-action="Index">
                                    DASHBOARD
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light @NavActive("Motocicleta", "Index")" asp-controller="Motocicleta" asp-action="Index">
                                    MIS MOTOS
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-light @NavActive("Perfil", "Index")" asp-controller="Perfil" asp-action="Index">
                                    PERFIL
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-warning @NavActive("MotoTrack", "Index")" asp-controller="MotoTrack" asp-action="Index">
                                    EXPLORAR
                                </a>
                            </li>

                            <li class="nav-item ms-auto">
                                <a class="nav-link text-light" href="/Auth/Logout">
                                    CERRAR SESIÓN
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENIDO -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="border-top footer text-muted">
        <div class="container">
             &copy; 2026 - MotoTrack -
            <a class="text-warning" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>
