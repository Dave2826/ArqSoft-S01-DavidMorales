@model MotoTrack.Domain.Models.RegistrarLecturaViewModel

@{
    ViewData["Title"] = "Actualizar Kilometraje";
}

<h2>Actualizar Kilometraje</h2>

<div class="card">
    <div class="card-body">

        <form asp-action="Crear" method="post">

            <input asp-for="MotocicletaId" type="hidden" />

            <div class="form-group">
                <label asp-for="Kilometraje"></label>
                <input asp-for="Kilometraje" />
                <span asp-validation-for="Kilometraje" class="error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Observaciones"></label>
                <textarea asp-for="Observaciones"></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn">Guardar Lectura</button>
                <a asp-controller="Motocicleta" asp-action="Index" class="btn-cancel">Volver</a>
            </div>

        </form>

    </div>
</div>

<div asp-validation-summary="All"></div>
