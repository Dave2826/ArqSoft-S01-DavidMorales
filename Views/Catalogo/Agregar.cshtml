@model Catalogo.Models.Item

<div class="container">

    <h1>Agregar Moto</h1>

    <form asp-action="Agregar" method="post" class="form-box">

        <div class="form-group">
            <label asp-for="Nombre"></label>
            <input asp-for="Nombre" />
        </div>

        <div class="form-group">
            <label asp-for="Marca"></label>
            <input asp-for="Marca" />
        </div>

        <div class="form-group">
            <label asp-for="Tipo"></label>
            <input asp-for="Tipo" />
        </div>

        <div class="form-group">
            <label asp-for="Ano"></label>
            <input asp-for="Ano" type="number" />
        </div>

        <div class="form-group">
            <label asp-for="Descripcion"></label>
            <textarea asp-for="Descripcion"></textarea>
        </div>

        <div class="form-actions">
            <button class="btn" type="submit">Guardar</button>
            <a class="btn-cancel" asp-action="Index">Cancelar</a>
        </div>

    </form>

</div>

