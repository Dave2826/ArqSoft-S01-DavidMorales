@model List<Catalogo.Models.Item>

@{
    var imagenMoto = new Dictionary<string, string>
    {
        { "Kawasaki Ninja 400", "/images/Kawasaki Ninja 400.png" },
        { "Yamaha R3", "/images/Yamaha R3.png" },
        { "Honda CBR600RR", "/images/Honda CBR600RR.png" },
        { "Italika DM200", "/images/Italika DM200.png" },
        { "BMW S1000RR", "/images/BMW S1000RR.png" }
    };
}

<div class="container">

    <h1>Catálogo de Motos</h1>

    <p class="contador-motos">
        Total de motocicletas registradas: <strong>@Model.Count</strong>
    </p>

    <div class="filtro">
        <a asp-action="Index">Todas</a>

        @foreach (var marca in ViewBag.Marcas as List<string>)
        {
            <a asp-action="Index" asp-route-marca="@marca">@marca</a>
        }
    </div>

    @foreach (var item in Model)
    {
        <div class="card">
            @if (imagenMoto.ContainsKey(item.Nombre))
            {
                <img src="@Url.Content(imagenMoto[item.Nombre])" alt="@item.Nombre" class="card-img" />
            }
            <h3>
                <a asp-action="Detalle" asp-route-id="@item.Id">
                    @item.Nombre
                </a>
            </h3>
            <p>@item.Marca - @item.Ano</p>
            <p>@item.Tipo</p>
            <div class="card-actions">
                <a class="btn btn-editar-sm" asp-action="Editar" asp-route-id="@item.Id">Editar</a>
            </div>
        </div>
    }

    <a class="btn" asp-action="Agregar">+ Agregar Moto</a>

</div>
