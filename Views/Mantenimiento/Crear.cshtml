@model MotoTrack.Domain.Models.Mantenimiento

@{
    ViewData["Title"] = "Registrar Mantenimiento";
}

<h2>Registrar Mantenimiento</h2>

<div class="card">
    <div class="card-body">

        <form asp-action="Crear" method="post">

            <input asp-for="MotocicletaId" type="hidden" />

            <div class="form-group">
                <label asp-for="Tipo"></label>
                <select asp-for="Tipo">
                    <option value="">Selecciona un tipo</option>
                    <option value="Cambio de aceite">Cambio de aceite</option>
                    <option value="Cadena">Cadena</option>
                    <option value="Balatas">Balatas</option>
                    <option value="Llantas">Llantas</option>
                    <option value="Filtro de aire">Filtro de aire</option>
                    <option value="Válvulas">Válvulas</option>
                    <option value="Revisión general">Revisión general</option>
                    <option value="Otro">Otro</option>
                </select>
                <span asp-validation-for="Tipo" class="error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Fecha"></label>
                <input asp-for="Fecha" type="date" />
                <span asp-validation-for="Fecha" class="error"></span>
            </div>

            <div class="form-group">
                <label asp-for="KilometrajeServicio"></label>
                <input asp-for="KilometrajeServicio" type="number" />
                <span asp-validation-for="KilometrajeServicio" class="error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Costo"></label>
                <input asp-for="Costo" type="number" step="0.01" />
                <span asp-validation-for="Costo" class="error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Taller"></label>
                <input asp-for="Taller" />
                <span asp-validation-for="Taller" class="error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Descripcion"></label>
                <textarea asp-for="Descripcion"></textarea>
                <span asp-validation-for="Descripcion" class="error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn">Guardar Mantenimiento</button>
                <a asp-controller="Motocicleta" asp-action="Index" class="btn-cancel">Cancelar</a>
            </div>

        </form>

    </div>
</div>

<div asp-validation-summary="All"></div>
