@model IEnumerable<MotoTrack.Domain.Models.Mantenimiento>

@functions {
    string TipoClass(string tipo) => tipo switch
    {
        "Cambio de aceite" => "aceite",
        "Cadena" => "cadena",
        "Balatas" => "balatas",
        "Llantas" => "llantas",
        "Filtro de aire" => "filtro",
        "Bujías" => "bujias",
        "Válvulas" => "valvulas",
        "Batería" => "bateria",
        "Suspensión" => "suspension",
        "Líquido de frenos" => "liquido",
        "Anticongelante" => "anticongelante",
        _ => "otro"
    };
}

@{
    var motocicleta = ViewData["Motocicleta"] as MotoTrack.Domain.Models.Motocicleta;
    if (motocicleta != null)
    {
        ViewData["Title"] = $"Historial de mantenimientos - {motocicleta.Marca} {motocicleta.Modelo}";
    }

    var agrupados = Model
        .OrderByDescending(m => m.Fecha)
        .GroupBy(m => m.Fecha.Year)
        .OrderByDescending(g => g.Key);
}

<h2>Historial de mantenimientos</h2>
@if (motocicleta != null)
{
    <h4>@motocicleta.Marca @motocicleta.Modelo</h4>
}
<hr />

<div class="timeline">
    @foreach (var grupo in agrupados)
    {
        <div class="timeline-year">
            <span class="timeline-year-label">@grupo.Key</span>
        </div>

        @foreach (var item in grupo)
        {
            var tipoCls = TipoClass(item.Tipo);
            <div class="timeline-item">
                <div class="timeline-dot timeline-dot--@tipoCls"></div>
                <div class="timeline-content">
                    <div class="timeline-meta">
                        <span class="timeline-date">@item.Fecha.ToString("dd MMM yyyy")</span>
                        <span class="timeline-km">@item.KilometrajeServicio km</span>
                    </div>
                    <div class="timeline-body">
                        <span class="timeline-type timeline-type--@tipoCls">@item.Tipo</span>
                        @if (item.Costo > 0)
                        {
                            <span class="timeline-cost">@("$" + item.Costo?.ToString("N0"))</span>
                        }
                        @if (!string.IsNullOrEmpty(item.Taller))
                        {
                            <span class="timeline-taller">
                                @item.Taller
                                @if (item.Taller == "Historial de compra")
                                {
                                    <span class="timeline-badge-compra">COMPRA USADA</span>
                                }
                            </span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(item.Descripcion))
                    {
                        <div class="timeline-desc">@item.Descripcion</div>
                    }
                </div>
            </div>
        }
    }
</div>

<div>
    <a asp-controller="Motocicleta" asp-action="Index" class="btn-cancel">
        Volver a Mis Motocicletas
    </a>
</div>
