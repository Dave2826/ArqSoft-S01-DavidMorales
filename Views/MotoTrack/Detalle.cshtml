@model MotoTrack.Domain.Models.Item

<div class="container detalle-container">

    <a class="btn btn-volver" asp-action="Index">
        <span class="flecha">&#8592;</span> Volver a Explorar
    </a>

    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
    {
        <div class="detalle-img-wrapper">
            <img src="@Url.Content(Model.ImagenUrl)"
                 alt="@Model.Nombre"
                 class="detalle-img" />
        </div>
    }

    <div class="detalle-header">

        <h1>@Model.Nombre</h1>

        <div class="detalle-badges">
            <span class="badge badge-marca">@Model.Marca</span>
            <span class="badge badge-tipo">@Model.Tipo</span>
            <span class="badge badge-ano">@Model.Ano</span>
        </div>

        <div class="detalle-actions">
            <a class="btn"
                   asp-action="Editar"
                   asp-route-id="@Model.Id">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="vertical-align:middle;margin-right:6px">
                    <path d="M17 3C17.2626 2.73735 17.5744 2.52901 17.9176 2.38687C18.2608 2.24473 18.6286 2.17157 19 2.17157C19.3714 2.17157 19.7392 2.24473 20.0824 2.38687C20.4256 2.52901 20.7374 2.73735 21 3C21.2626 3.26264 21.471 3.57444 21.6131 3.9176C21.7553 4.26077 21.8284 4.62856 21.8284 5C21.8284 5.37144 21.7553 5.73923 21.6131 6.08239C21.471 6.42555 21.2626 6.73735 21 7L7.5 20.5L2 22L3.5 16.5L17 3Z" stroke="#ff7a00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Editar moto
            </a>
        </div>

    </div>

    <div class="detalle-adoptar">
        @if (Context.Session.GetString("UsuarioId") != null)
        {
            <a class="btn-mototrack-primary"
               asp-controller="Motocicleta"
               asp-action="Crear"
               asp-route-marca="@Model.Marca"
               asp-route-modelo="@Model.Nombre"
               asp-route-ano="@Model.Ano"
               asp-route-cilindrada="@Model.Cilindrada"
               asp-route-imagenUrl="@Model.ImagenUrl">
                Usar como mi motocicleta
            </a>
        }
        else
        {
            <a class="btn-mototrack-primary"
               asp-controller="Auth"
               asp-action="Login">
                Inicia sesion para agregar esta moto
            </a>
        }
    </div>

    <!-- Specs highlight -->
    <div class="specs-highlight">

        <div class="spec-item">
            <span class="spec-value">@Model.Cilindrada</span>
            <span class="spec-label">Cilindrada</span>
        </div>

        <div class="spec-item">
            <span class="spec-value">@Model.Potencia</span>
            <span class="spec-label">Potencia</span>
        </div>

        <div class="spec-item">
            <span class="spec-value">@Model.VelocidadMax</span>
            <span class="spec-label">Vel. Máxima</span>
        </div>

        <div class="spec-item">
            <span class="spec-value">@Model.Peso</span>
            <span class="spec-label">Peso</span>
        </div>

    </div>

    <div class="detalle-grid">

        <div class="detalle-card">

            <div class="detalle-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="4" stroke="#ff7a00" stroke-width="2"/>
                    <path d="M12 2V5M12 19V22M2 12H5M19 12H22M4.93 4.93L7.05 7.05M16.95 16.95L19.07 19.07M4.93 19.07L7.05 16.95M16.95 7.05L19.07 4.93" stroke="#ff7a00" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </div>

            <h3>Ficha técnica</h3>

            <ul>
                <li><strong>Cilindrada:</strong> @Model.Cilindrada</li>
                <li><strong>Potencia:</strong> @Model.Potencia</li>
                <li><strong>Velocidad máx:</strong> @Model.VelocidadMax</li>
                <li><strong>Peso:</strong> @Model.Peso</li>
                <li><strong>Transmisión:</strong> @Model.Transmision</li>
                <li><strong>Tanque:</strong> @Model.CapacidadTanque</li>
                <li><strong>Motor:</strong> @Model.TipoMotor</li>
            </ul>

        </div>

        <div class="detalle-card">

            <div class="detalle-card-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path d="M14 2H6C5.46957 2 4.96086 2.21071 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V20C4 20.5304 4.21071 21.0391 4.58579 21.4142C4.96086 21.7893 5.46957 22 6 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8L14 2Z" stroke="#ff7a00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M14 2V8H20" stroke="#ff7a00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <line x1="8" y1="13" x2="16" y2="13" stroke="#ff7a00" stroke-width="2" stroke-linecap="round"/>
                    <line x1="8" y1="17" x2="16" y2="17" stroke="#ff7a00" stroke-width="2" stroke-linecap="round"/>
                    <line x1="8" y1="9" x2="10" y2="9" stroke="#ff7a00" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </div>

            <h3>Descripción</h3>

            <p>@Model.Descripcion</p>

        </div>

    </div>

</div>
