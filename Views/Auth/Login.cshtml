@model MotoTrack.Domain.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<h2>Iniciar Sesión</h2>

@if (ViewBag.Error != null)
{
    <div style="color:red">
        @ViewBag.Error
    </div>
}

<form asp-action="Login" method="post">

    <div>
        <label>Correo</label>
        <input asp-for="Correo" />
        <span asp-validation-for="Correo"></span>
    </div>

    <br />

    <div>
        <label>Contraseña</label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>

    <br />

    <button type="submit">
        Iniciar sesión
    </button>

</form>

<br />

<a asp-controller="Auth"
   asp-action="Registro">
    Crear cuenta nueva
</a>
