@model MotoTrack.Domain.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<h2>Iniciar Sesión</h2>

@if (ViewBag.Error != null)
{
    <div class="error-box">@ViewBag.Error</div>
}

<div class="card">
    <div class="card-body">

        <form asp-action="Login" method="post">

            <div class="form-group">
                <label>Correo</label>
                <input asp-for="Correo" />
                <span asp-validation-for="Correo" class="error"></span>
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <input asp-for="Password" type="password" />
                <span asp-validation-for="Password" class="error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn">Iniciar sesión</button>
            </div>

        </form>

    </div>
</div>

<p class="mt-3">
    <a asp-controller="Auth" asp-action="Registro">Crear cuenta nueva</a>
</p>
