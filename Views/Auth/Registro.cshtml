@model MotoTrack.Domain.Models.Usuario

@{
    ViewData["Title"] = "Registro";
}

<h2>Registro de Usuario</h2>

@if (ViewBag.Error != null)
{
    <div class="error-box">@ViewBag.Error</div>
}

<div class="card">
    <div class="card-body">

        <form asp-action="Registro" method="post">

            <div class="form-group">
                <label>Nombre</label>
                <input asp-for="Nombre" />
                <span asp-validation-for="Nombre" class="error"></span>
            </div>

            <div class="form-group">
                <label>Apellido</label>
                <input asp-for="Apellido" />
                <span asp-validation-for="Apellido" class="error"></span>
            </div>

            <div class="form-group">
                <label>Correo</label>
                <input asp-for="Correo" />
                <span asp-validation-for="Correo" class="error"></span>
            </div>

            <div class="form-group">
                <label>Contraseña</label>
                <input asp-for="PasswordHash" type="password" />
                <span asp-validation-for="PasswordHash" class="error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn">Registrarme</button>
                <a asp-controller="Auth" asp-action="Login" class="btn-cancel">Ya tengo cuenta</a>
            </div>

        </form>

    </div>
</div>
