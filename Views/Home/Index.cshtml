@model MotoTrack.Controllers.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard - MotoTrack";
}

<div class="container mt-4">

    <h2 class="mb-4">Dashboard</h2>

    @if (Model.Motocicletas.Any())
    {
        <div class="row mb-4">
            <div class="col-md-6">

                <label class="form-label">
                    Motocicleta seleccionada
                </label>

                <form method="get"
                      asp-controller="Home"
                      asp-action="Index">

                    <select name="motocicletaId"
                            class="form-select"
                            onchange="this.form.submit()">

                        @foreach (var moto in Model.Motocicletas)
                        {
                            <option value="@moto.Id"
                                    selected="@(moto.Id == Model.MotocicletaSeleccionadaId)">
                                @moto.Marca @moto.Modelo
                            </option>
                        }

                    </select>

                </form>

            </div>
        </div>
    }

    <div class="row">

        <div class="col-md-3 mb-4">
            <div class="card border-primary">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Motocicletas</h5>
                    <h3 class="text-primary">@Model.TotalMotocicletas</h3>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card border-success">
                <div class="card-body text-center">
                    <h5 class="card-title">Kilometraje Actual</h5>
                    <h3 class="text-success">@Model.KilometrajeStatus</h3>

                    @if (Model.PrimeraMotocicleta != null)
                    {
                        <small class="text-muted">
                            @Model.PrimeraMotocicleta.Marca
                            @Model.PrimeraMotocicleta.Modelo
                        </small>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card border-info">
                <div class="card-body text-center">
                    <h5 class="card-title">Último Mantenimiento</h5>

                    <h4 class="text-info">
                        @(Model.UltimoMantenimiento?.Tipo ?? "Ninguno")
                    </h4>

                    <small class="text-muted">
                        @(Model.UltimoMantenimiento?.Fecha.ToString("dd/MM/yyyy") ?? "Sin registro")
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-4">
            <div class="card border-warning">
                <div class="card-body text-center">

                    <h5 class="card-title">Mi Motocicleta</h5>

                    @if (Model.PrimeraMotocicleta != null)
                    {
                        <p class="mb-1">@Model.PrimeraMotocicleta.Marca</p>
                        <p class="mb-1">@Model.PrimeraMotocicleta.Modelo</p>
                        <p class="mb-1">@Model.PrimeraMotocicleta.Ano</p>
                        <p class="mb-0">
                            @Model.PrimeraMotocicleta.KilometrajeActual km
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">
                            No hay motocicletas
                        </p>
                    }

                </div>
            </div>
        </div>

    </div>

    <div class="row mt-3">
        <div class="col-12">

            <div class="card border-dark">

                <div class="card-body">

                    <h5 class="card-title">
                        Últimos Mantenimientos Registrados
                    </h5>

                    <div class="row text-center">

                        <div class="col-md-2">
                            <strong>Aceite</strong>
                            <p>@Model.UltimoAceite</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Cadena</strong>
                            <p>@Model.UltimaCadena</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Balatas</strong>
                            <p>@Model.UltimasBalatas</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Llantas</strong>
                            <p>@Model.UltimasLlantas</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Filtro Aire</strong>
                            <p>@Model.UltimoFiltroAire</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Válvulas</strong>
                            <p>@Model.UltimasValvulas</p>
                        </div>

                    </div>

                </div>

            </div>

            <div class="row mt-3">
                <div class="col-12">

                    <div class="card border-warning">

                        <div class="card-body">

                            <h5 class="card-title">
                                Estado General de Mantenimiento
                            </h5>

                            <div class="row text-center">

                                <div class="col-md-2">
                                     <strong>Aceite</strong>
                                     <p><span class="badge @(Model.EstadoAceite == "AL DÍA" ? "bg-success" : Model.EstadoAceite == "PRÓXIMO" ? "bg-warning" : Model.EstadoAceite == "VENCIDO" ? "bg-danger" : "bg-secondary")">@Model.EstadoAceite</span></p>
                                </div>

                                <div class="col-md-2">
                                     <strong>Cadena</strong>
                                     <p><span class="badge @(Model.EstadoCadena == "AL DÍA" ? "bg-success" : Model.EstadoCadena == "PRÓXIMO" ? "bg-warning" : Model.EstadoCadena == "VENCIDO" ? "bg-danger" : "bg-secondary")">@Model.EstadoCadena</span></p>
                                </div>

                                <div class="col-md-2">
                                     <strong>Balatas</strong>
                                     <p><span class="badge @(Model.EstadoBalatas == "AL DÍA" ? "bg-success" : Model.EstadoBalatas == "PRÓXIMO" ? "bg-warning" : Model.EstadoBalatas == "VENCIDO" ? "bg-danger" : "bg-secondary")">@Model.EstadoBalatas</span></p>
                                </div>

                                <div class="col-md-2">
                                     <strong>Llantas</strong>
                                     <p><span class="badge @(Model.EstadoLlantas == "AL DÍA" ? "bg-success" : Model.EstadoLlantas == "PRÓXIMO" ? "bg-warning" : Model.EstadoLlantas == "VENCIDO" ? "bg-danger" : "bg-secondary")">@Model.EstadoLlantas</span></p>
                                </div>

                                <div class="col-md-2">
                                     <strong>Filtro Aire</strong>
                                     <p><span class="badge @(Model.EstadoFiltroAire == "AL DÍA" ? "bg-success" : Model.EstadoFiltroAire == "PRÓXIMO" ? "bg-warning" : Model.EstadoFiltroAire == "VENCIDO" ? "bg-danger" : "bg-secondary")">@Model.EstadoFiltroAire</span></p>
                                </div>

                                <div class="col-md-2">
                                     <strong>Válvulas</strong>
                                     <p><span class="badge @(Model.EstadoValvulas == "AL DÍA" ? "bg-success" : Model.EstadoValvulas == "PRÓXIMO" ? "bg-warning" : Model.EstadoValvulas == "VENCIDO" ? "bg-danger" : "bg-secondary")">@Model.EstadoValvulas</span></p>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">

            <div class="card border-success">

                <div class="card-body">

                    <h5 class="card-title">
                        Próximos Mantenimientos
                    </h5>

                    <div class="row text-center">

                        <div class="col-md-2">
                            <strong>Aceite</strong>
                            <p>@Model.ProximoAceite</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Cadena</strong>
                            <p>@Model.ProximaCadena</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Balatas</strong>
                            <p>@Model.ProximasBalatas</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Llantas</strong>
                            <p>@Model.ProximasLlantas</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Filtro Aire</strong>
                            <p>@Model.ProximoFiltroAire</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Válvulas</strong>
                            <p>@Model.ProximasValvulas</p>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

 <div class="row mt-4">
        <div class="col-12">

            <div class="card">

                <div class="card-body">

                    <h5 class="card-title">
                        Accesos Rápidos
                    </h5>

                    <div class="d-flex flex-wrap gap-2">

                        <a asp-controller="Motocicleta"
                           asp-action="Index"
                           class="btn btn-outline-primary">
                            Mis Motocicletas
                        </a>

                        <a asp-controller="Motocicleta"
                           asp-action="Crear"
                           class="btn btn-outline-success">
                            Agregar Motocicleta
                        </a>

                        @if (Model.PrimeraMotocicleta != null)
                        {
                            <a asp-controller="LecturaKilometraje"
                               asp-action="Crear"
                               asp-route-motocicletaId="@Model.MotocicletaSeleccionadaId"
                               class="btn btn-outline-info">
                                Registrar Kilometraje
                            </a>

                            <a asp-controller="Mantenimiento"
                               asp-action="Crear"
                               asp-route-motocicletaId="@Model.MotocicletaSeleccionadaId"
                               class="btn btn-outline-warning">
                                Registrar Mantenimiento
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-outline-info" disabled>
                                Registrar Kilometraje
                            </button>

                            <button class="btn btn-outline-warning" disabled>
                                Registrar Mantenimiento
                            </button>

                            <div class="w-100 mt-2 text-muted">
                                No tienes motocicletas registradas. Agrega una motocicleta para comenzar a registrar kilometrajes y mantenimientos.
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>