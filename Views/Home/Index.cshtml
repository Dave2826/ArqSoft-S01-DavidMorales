@model MotoTrack.Controllers.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard - MotoTrack";
}

<div class="container mt-4">

    <h2 class="mb-4">Dashboard</h2>

    @if (Model.Motocicletas.Any())
    {
        <div class="row mb-4">
            <div class="col-md-6">

                <label class="form-label">
                    Motocicleta seleccionada
                </label>

                <form method="get"
                      asp-controller="Home"
                      asp-action="Index">

                    <select name="motocicletaId"
                            class="form-select"
                            onchange="this.form.submit()">

                        @foreach (var moto in Model.Motocicletas)
                        {
                            <option value="@moto.Id"
                                    selected="@(moto.Id == Model.MotocicletaSeleccionadaId)">
                                @moto.Marca @moto.Modelo
                            </option>
                        }

                    </select>

                </form>

            </div>
        </div>
    }

    @if (Model.TieneEstimados)
    {
        <div class="banner-info">
            Algunos cálculos usan el kilometraje de compra como referencia.
            Registra mantenimientos reales para obtener datos precisos.
        </div>
    }

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card card-stat">
                <div class="card-body text-center">
                    <div class="card-stat-label">Total Motocicletas</div>
                    <div class="card-stat-value">@Model.TotalMotocicletas</div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card card-stat">
                <div class="card-body text-center">
                    <div class="card-stat-label">Kilometraje Actual</div>
                    <div class="card-stat-value">@Model.KilometrajeStatus</div>

                    @if (Model.PrimeraMotocicleta != null)
                    {
                        <div class="card-stat-sub">
                            @Model.PrimeraMotocicleta.Marca
                            @Model.PrimeraMotocicleta.Modelo
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card card-stat">
                <div class="card-body text-center">
                    <div class="card-stat-label">Último Mantenimiento</div>

                    <div class="card-stat-value" style="font-size:1.3rem">
                        @(Model.UltimoMantenimiento?.Tipo ?? "Ninguno")
                    </div>

                    <div class="card-stat-sub">
                        @(Model.UltimoMantenimiento?.Fecha.ToString("dd/MM/yyyy") ?? "Sin registro")
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row mt-3">
        <div class="col-12">
            <div class="card hero-card">

                <div class="hero-img"></div>

                <div class="hero-body">
                    @if (Model.PrimeraMotocicleta != null)
                    {
                        <div class="hero-title">
                            @Model.PrimeraMotocicleta.Marca @Model.PrimeraMotocicleta.Modelo
                            <span class="hero-year">@Model.PrimeraMotocicleta.Ano</span>
                        </div>
                        <div class="hero-km">@Model.PrimeraMotocicleta.KilometrajeActual km</div>
                        <div class="hero-mto">
                            Último: @(Model.UltimoMantenimiento?.Tipo ?? "Ninguno")
                            @if (Model.UltimoMantenimiento != null)
                            {
                                <text>&middot; @Model.UltimoMantenimiento.Fecha.ToString("dd/MM/yyyy")</text>
                            }
                        </div>
                        <div class="hero-actions">
                            <a class="btn-action" asp-controller="LecturaKilometraje" asp-action="Crear" asp-route-motocicletaId="@Model.MotocicletaSeleccionadaId">Reg. KM</a>
                            <a class="btn-action" asp-controller="Mantenimiento" asp-action="Crear" asp-route-motocicletaId="@Model.MotocicletaSeleccionadaId">Reg. Manto</a>
                            <a class="btn-action" asp-controller="Mantenimiento" asp-action="Index" asp-route-motocicletaId="@Model.MotocicletaSeleccionadaId">Historial</a>
                            <a class="btn-action" asp-controller="Mantenimiento" asp-action="Gastos" asp-route-motocicletaId="@Model.MotocicletaSeleccionadaId">Gastos</a>
                        </div>
                    }
                    else
                    {
                        <div class="hero-mto">Selecciona una motocicleta para ver su información</div>
                    }
                </div>

            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">

            <div class="card card-section">

                <div class="card-body">

                    <h5 class="card-title">
                        Últimos Mantenimientos Registrados
                    </h5>

                    <div class="row text-center">

                        <div class="col-md-2">
                            <strong>Aceite</strong>
                            <p>@Model.UltimoAceite</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Cadena</strong>
                            <p>@Model.UltimaCadena</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Balatas</strong>
                            <p>@Model.UltimasBalatas</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Llantas</strong>
                            <p>@Model.UltimasLlantas</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Filtro Aire</strong>
                            <p>@Model.UltimoFiltroAire</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Válvulas</strong>
                            <p>@Model.UltimasValvulas</p>
                        </div>

                    </div>

                </div>

            </div>

            <div class="row mt-3">
                <div class="col-12">

                    <div class="card card-section">

                        <div class="card-body">

                            <h5 class="card-title">
                                Estado General de Mantenimiento
                            </h5>

                            <div class="row text-center">

                                <div class="col-md-2">
                                     <strong>Aceite</strong>
                                     @if(Model.AceiteEsEstimado){<small class="text-muted">(estimado)</small>}
                                     <p><span class="badge-estado @(Model.EstadoAceite == "AL DÍA" ? "badge-estado--al-dia" : Model.EstadoAceite == "PRÓXIMO" ? "badge-estado--proximo" : Model.EstadoAceite == "VENCIDO" ? "badge-estado--vencido" : "badge-estado--sin-registro")">@Model.EstadoAceite</span></p>
                                </div>

                                <div class="col-md-2">
                                     <strong>Cadena</strong>
                                     @if(Model.CadenaEsEstimado){<small class="text-muted">(estimado)</small>}
                                     <p><span class="badge-estado @(Model.EstadoCadena == "AL DÍA" ? "badge-estado--al-dia" : Model.EstadoCadena == "PRÓXIMO" ? "badge-estado--proximo" : Model.EstadoCadena == "VENCIDO" ? "badge-estado--vencido" : "badge-estado--sin-registro")">@Model.EstadoCadena</span></p>
                                </div>

                                <div class="col-md-2">
                                     <strong>Balatas</strong>
                                     @if(Model.BalatasEsEstimado){<small class="text-muted">(estimado)</small>}
                                     <p><span class="badge-estado @(Model.EstadoBalatas == "AL DÍA" ? "badge-estado--al-dia" : Model.EstadoBalatas == "PRÓXIMO" ? "badge-estado--proximo" : Model.EstadoBalatas == "VENCIDO" ? "badge-estado--vencido" : "badge-estado--sin-registro")">@Model.EstadoBalatas</span></p>
                                </div>

                                <div class="col-md-2">
                                     <strong>Llantas</strong>
                                     @if(Model.LlantasEsEstimado){<small class="text-muted">(estimado)</small>}
                                     <p><span class="badge-estado @(Model.EstadoLlantas == "AL DÍA" ? "badge-estado--al-dia" : Model.EstadoLlantas == "PRÓXIMO" ? "badge-estado--proximo" : Model.EstadoLlantas == "VENCIDO" ? "badge-estado--vencido" : "badge-estado--sin-registro")">@Model.EstadoLlantas</span></p>
                                </div>

                                <div class="col-md-2">
                                     <strong>Filtro Aire</strong>
                                     @if(Model.FiltroAireEsEstimado){<small class="text-muted">(estimado)</small>}
                                     <p><span class="badge-estado @(Model.EstadoFiltroAire == "AL DÍA" ? "badge-estado--al-dia" : Model.EstadoFiltroAire == "PRÓXIMO" ? "badge-estado--proximo" : Model.EstadoFiltroAire == "VENCIDO" ? "badge-estado--vencido" : "badge-estado--sin-registro")">@Model.EstadoFiltroAire</span></p>
                                </div>

                                <div class="col-md-2">
                                     <strong>Válvulas</strong>
                                     @if(Model.ValvulasEsEstimado){<small class="text-muted">(estimado)</small>}
                                     <p><span class="badge-estado @(Model.EstadoValvulas == "AL DÍA" ? "badge-estado--al-dia" : Model.EstadoValvulas == "PRÓXIMO" ? "badge-estado--proximo" : Model.EstadoValvulas == "VENCIDO" ? "badge-estado--vencido" : "badge-estado--sin-registro")">@Model.EstadoValvulas</span></p>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>

    <div class="row mt-3">
        <div class="col-12">

            <div class="card card-section">

                <div class="card-body">

                    <h5 class="card-title">
                        Próximos Mantenimientos
                    </h5>

                    <div class="row text-center">

                        <div class="col-md-2">
                            <strong>Aceite</strong>
                            <p>@Model.ProximoAceite @if(Model.AceiteEsEstimado){<span class="text-muted">· estimado</span>}</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Cadena</strong>
                            <p>@Model.ProximaCadena @if(Model.CadenaEsEstimado){<span class="text-muted">· estimado</span>}</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Balatas</strong>
                            <p>@Model.ProximasBalatas @if(Model.BalatasEsEstimado){<span class="text-muted">· estimado</span>}</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Llantas</strong>
                            <p>@Model.ProximasLlantas @if(Model.LlantasEsEstimado){<span class="text-muted">· estimado</span>}</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Filtro Aire</strong>
                            <p>@Model.ProximoFiltroAire @if(Model.FiltroAireEsEstimado){<span class="text-muted">· estimado</span>}</p>
                        </div>

                        <div class="col-md-2">
                            <strong>Válvulas</strong>
                            <p>@Model.ProximasValvulas @if(Model.ValvulasEsEstimado){<span class="text-muted">· estimado</span>}</p>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

 <div class="row mt-4">
        <div class="col-12">

            <div class="card">

                <div class="card-body">

                    <h5 class="card-title">
                        Accesos Rápidos
                    </h5>

                    <div class="d-flex flex-wrap gap-2">

                        <a asp-controller="Motocicleta"
                           asp-action="Index"
                           class="btn-action">
                            Mis Motocicletas
                        </a>

                        <a asp-controller="Motocicleta"
                           asp-action="Crear"
                           class="btn-action">
                            Agregar Motocicleta
                        </a>

                        @if (Model.PrimeraMotocicleta != null)
                        {
                            <a asp-controller="LecturaKilometraje"
                               asp-action="Crear"
                               asp-route-motocicletaId="@Model.MotocicletaSeleccionadaId"
                               class="btn-action">
                                Registrar Kilometraje
                            </a>

                            <a asp-controller="Mantenimiento"
                               asp-action="Crear"
                               asp-route-motocicletaId="@Model.MotocicletaSeleccionadaId"
                               class="btn-action">
                                Registrar Mantenimiento
                            </a>
                        }
                        else
                        {
                            <button class="btn-action" disabled>
                                Registrar Kilometraje
                            </button>

                            <button class="btn-action" disabled>
                                Registrar Mantenimiento
                            </button>

                            <div class="w-100 mt-2 text-muted">
                                No tienes motocicletas registradas. Agrega una motocicleta para comenzar a registrar kilometrajes y mantenimientos.
                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>