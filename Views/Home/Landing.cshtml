@{
    ViewData["Title"] = "MotoTrack";
}

<div class="landing-page">

    <div class="landing-hero">
        <div class="landing-brand-area">
            <svg width="48" height="48" viewBox="0 0 32 32" class="navbar-logo">
                <path d="M6 26 L10 6 L16 16 L22 6 L26 26" stroke="#ff7a00" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <h1 class="landing-title">MOTOTRACK</h1>
        <p class="landing-subtitle">
            Tu garaje digital. Controla tus motocicletas, mantenimientos y estadísticas desde un solo lugar.
        </p>
        <div class="landing-ctas">
            <a asp-controller="Auth" asp-action="Registro" class="btn-mototrack-primary">Comenzar</a>
            <a asp-controller="Auth" asp-action="Login" class="btn-landing-secondary">Iniciar Sesión</a>
            <a asp-controller="MotoTrack" asp-action="Index" class="btn-landing-secondary">Explorar</a>
        </div>
    </div>

    <div class="landing-benefits">
        <div class="landing-benefit">
            <div class="landing-benefit-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none">
                    <path d="M4 20V10M10 20V4M16 20V8M22 20H2" stroke="#ff7a00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <h3 class="landing-benefit-title">Control Total</h3>
            <p class="landing-benefit-desc">
                Registra kilometraje, programa mantenimientos y lleva el control de gastos de cada una de tus motocicletas.
            </p>
        </div>
        <div class="landing-benefit">
            <div class="landing-benefit-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none">
                    <path d="M18 8C18 6.4087 17.3679 4.88258 16.2426 3.75736C15.1174 2.63214 13.5913 2 12 2C10.4087 2 8.88258 2.63214 7.75736 3.75736C6.63214 4.88258 6 6.4087 6 8C6 15 3 17 3 17H21C21 17 18 15 18 8Z" stroke="#ff7a00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M13.73 21C13.5542 21.3031 13.3019 21.5547 13 21.7295C12.6981 21.9044 12.3559 21.9965 12 21.9965C11.6441 21.9965 11.3019 21.9044 11 21.7295C10.6981 21.5547 10.4458 21.3031 10.27 21" stroke="#ff7a00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <h3 class="landing-benefit-title">Alertas Inteligentes</h3>
            <p class="landing-benefit-desc">
                Recibe notificaciones visuales sobre servicios vencidos o próximos. Nunca más olvides un cambio de aceite.
            </p>
        </div>
        <div class="landing-benefit">
            <div class="landing-benefit-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none">
                    <circle cx="6" cy="17" r="3" stroke="#ff7a00" stroke-width="2"/>
                    <circle cx="18" cy="17" r="3" stroke="#ff7a00" stroke-width="2"/>
                    <path d="M12 5L15 9H21" stroke="#ff7a00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M3 17H6M18 17H21" stroke="#ff7a00" stroke-width="2" stroke-linecap="round"/>
                    <path d="M9 17H15" stroke="#ff7a00" stroke-width="2" stroke-linecap="round"/>
                    <path d="M15 9L12 14L9 17" stroke="#ff7a00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <h3 class="landing-benefit-title">Catálogo Integrado</h3>
            <p class="landing-benefit-desc">
                Explora especificaciones técnicas de distintas motocicletas mientras gestionas tu propia flota.
            </p>
        </div>
    </div>

    <div class="landing-showcase">
        <div class="landing-showcase-image"></div>
        <p class="landing-showcase-text">Diseñado para motociclistas</p>
        <p class="text-muted">Control, mantenimiento y seguimiento en un solo lugar.</p>
    </div>

</div>
