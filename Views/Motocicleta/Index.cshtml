@model List<MotoTrack.Domain.Models.Motocicleta>

@{
    ViewData["Title"] = "Mis Motocicletas";
}

<h2>Mis Motocicletas</h2>

<p>
    <a asp-action="Crear">
        Registrar Motocicleta
    </a>
</p>

<hr />

@if (!Model.Any())
{
    <p>No tienes motocicletas registradas.</p>
}
else
{
    @foreach (var moto in Model)
    {
        <div>

            <h4>
                @moto.Marca @moto.Modelo
            </h4>

            <p>
                Año: @moto.Ano
            </p>

            <p>
                Kilometraje:
                @moto.KilometrajeActual km
            </p>

            <p>
                <a asp-action="Editar" 
                   asp-route-id="@moto.Id">
                    Editar
                </a> |
                
                <a asp-controller="LecturaKilometraje" 
                   asp-action="Crear" 
                   asp-route-motocicletaId="@moto.Id">
                    Actualizar KM
                </a> | 
                
                <a asp-controller="Mantenimiento"
                   asp-action="Crear"
                   asp-route-motocicletaId="@moto.Id">
                    Registrar mantenimiento
                </a> | 
                
                <a asp-controller="Mantenimiento"
                   asp-action="Index"
                   asp-route-motocicletaId="@moto.Id">
                    Ver Historial
                </a> |
                
                <a asp-action="Eliminar" 
                   asp-route-id="@moto.Id"
                   class="text-danger"
                   onclick="return confirm('¿Estás seguro de eliminar esta motocicleta?')">
                    Eliminar
                </a>
            </p>

            <hr />

        </div>
    }
}
